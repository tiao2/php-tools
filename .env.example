# Debug mode
APP_DEBUG=true

# Top-level module switches
SSO_ENABLED=true
COMMUNITY_ENABLED=true
API_ENABLED=true

# Community sub-module switches
COMMUNITY_USER_ENABLED=true
COMMUNITY_ACL_ENABLED=true
COMMUNITY_CONTENT_ENABLED=true
COMMUNITY_API_ENABLED=true

# SSO configuration
SSO_TOKEN_EXPIRE=3600
SSO_AUTHCODE_EXPIRE=3600
SSO_IPV6_PREFIX=64

# Database configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sso_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Redis (optional, for distributed rate limiting)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# API rate limit
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_WINDOW=60
API_RATE_LIMIT_DRIVER=memory

# API versioning
API_VERSION_ENABLED=true

# API authentication
API_AUTH_ENABLED=true